# Copy to .env (never commit .env). Demo defaults shown.
SECRET_KEY=change-me-to-a-long-random-string
# SQLite DB + uploads + PDFs live here (mount a persistent disk in production)
DATA_DIR=./data
# Private, git-ignored: gallery/ + classroom/ (built by scripts/build_demo_assets.py)
ASSET_DIR=./demo_assets
# Seed the DEMO database on first start
AUTO_SEED=1
PORT=5000
